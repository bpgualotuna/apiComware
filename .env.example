# ============================================================================
# CONFIGURACIÓN DE LA API COMWARE
# ============================================================================
# Copia este archivo como .env y configura tus valores

# Entorno de ejecución
NODE_ENV=development  # development | production

# Puerto del servidor API
# En Render, esto se ignora y se usa la variable PORT automática
API_PORT=5000

# ============================================================================
# BASE DE DATOS POSTGRESQL
# ============================================================================

# Configuración LOCAL (desarrollo)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=tu_password_local
# DB_NAME=comware
# DB_SSL=false

# Configuración RENDER (producción)
DB_HOST=dpg-d639anv5r7bs73dflqa0-a.oregon-postgres.render.com
DB_PORT=5432
DB_USER=comware_user
DB_PASSWORD=OI2NXweufaHiBhRD1ACYNFGc9pQQOgjO
DB_NAME=comware
DB_SSL=true

# ============================================================================
# FRONTEND (CORS)
# ============================================================================
# URL del frontend en producción (configurar en Render)
# Ejemplo: https://tu-frontend.onrender.com
FRONTEND_URL=

# ============================================================================
# SEGURIDAD
# ============================================================================
# Clave secreta para JWT (generar una segura en producción)
# JWT_SECRET=tu_clave_secreta_muy_larga_y_segura_aqui

# ============================================================================
# NOTAS
# ============================================================================
# 1. NUNCA subas el archivo .env a Git
# 2. En Render, configura estas variables en el dashboard
# 3. Genera un JWT_SECRET seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
